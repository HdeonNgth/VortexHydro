# Rahasia ini TIDAK dipakai di frontend. Set sebagai Supabase Secrets (Edge Function):
#   supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Opsional: daftar origin yang boleh memanggil fungsi (pisahkan dengan koma)
ALLOWED_ORIGINS=https://hdeonngth.github.io,http://localhost:8000
# SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY disediakan otomatis oleh Supabase untuk Edge Function.
# Frontend hanya memakai URL fungsi + publishable key di assets/js/ai-config.js.
