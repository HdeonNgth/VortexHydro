NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Lokasi file SQLite lokal (jangan unggah ke GitHub)
DB_PATH=database/data/vortex.sqlite

# Kunci rahasia khusus perangkat ESP32 (minimal 32 karakter acak)
ESP_API_KEY=replace-with-a-random-key-at-least-32-characters
API_KEY=replace-with-a-random-key-at-least-32-characters

# Origin frontend yang diizinkan mengakses API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Akun Admin lokal untuk script `npm run seed:admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
